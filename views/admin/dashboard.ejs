<%- include('../partials/header') %>
<div class="d-flex">
  <%- include('../partials/nav') %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="mb-0 fw-bold">📊 Dashboard</h4>
      <small class="text-muted">Welcome back, Admin</small>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card stat-card p-4 text-center">
          <div style="font-size:2rem">🛒</div>
          <h3 class="fw-bold text-primary mt-1"><%= stats.totalOrders %></h3>
          <div class="text-muted small">Total Orders</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stat-card p-4 text-center">
          <div style="font-size:2rem">📅</div>
          <h3 class="fw-bold text-success mt-1"><%= stats.todayOrders %></h3>
          <div class="text-muted small">Orders Today</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stat-card p-4 text-center">
          <div style="font-size:2rem">⏳</div>
          <h3 class="fw-bold text-warning mt-1"><%= stats.pendingOrders %></h3>
          <div class="text-muted small">Active Orders</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card stat-card p-4 text-center">
          <div style="font-size:2rem">💰</div>
          <h3 class="fw-bold text-success mt-1">R<%= Number(stats.todayRevenue).toFixed(2) %></h3>
          <div class="text-muted small">Revenue Today</div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Recent Orders -->
      <div class="col-lg-8">
        <div class="card shadow-sm">
          <div class="card-header d-flex justify-content-between align-items-center bg-white border-0 pt-3">
            <h6 class="fw-bold mb-0">Recent Orders</h6>
            <a href="/admin/orders" class="btn btn-sm btn-outline-primary">View All</a>
          </div>
          <div class="card-body p-0">
            <% if (recentOrders.length === 0) { %>
              <p class="text-muted text-center p-4">No orders yet. Share your WhatsApp number to start receiving orders!</p>
            <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Time</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentOrders.forEach(order => { %>
                  <tr>
                    <td><strong>#<%= order.id %></strong></td>
                    <td>
                      <div><%= order.customer_name || 'Unknown' %></div>
                      <small class="text-muted"><%= order.customer_phone || '' %></small>
                    </td>
                    <td>R<%= Number(order.total).toFixed(2) %></td>
                    <td>
                      <span class="badge badge-<%= order.status %>"><%= order.status %></span>
                    </td>
                    <td><small class="text-muted"><%= new Date(order.created_at).toLocaleString() %></small></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Alerts & Info -->
      <div class="col-lg-4">
        <!-- Stock Alerts -->
        <div class="card shadow-sm mb-3">
          <div class="card-header bg-white border-0 pt-3">
            <h6 class="fw-bold mb-0">⚠️ Stock Alerts</h6>
          </div>
          <div class="card-body">
            <% if (lowStockAlerts.length === 0) { %>
              <p class="text-success small mb-0">✅ All stock levels are healthy</p>
            <% } else { %>
              <% lowStockAlerts.forEach(alert => { %>
              <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <div>
                  <strong class="small"><%= alert.name %></strong>
                  <br><span class="badge bg-danger"><%= alert.stock %> left</span>
                </div>
                <a href="/admin/products" class="btn btn-xs btn-outline-warning btn-sm">Restock</a>
              </div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="card shadow-sm">
          <div class="card-header bg-white border-0 pt-3">
            <h6 class="fw-bold mb-0">💡 Quick Info</h6>
          </div>
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted small">Total Revenue</span>
              <strong>R<%= Number(stats.totalRevenue).toFixed(2) %></strong>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted small">Active Products</span>
              <strong><%= stats.productCount %></strong>
            </div>
            <hr>
            <a href="/admin/ai-chat" class="btn btn-primary btn-sm w-100">
              <i class="bi bi-robot"></i> Ask AI Assistant
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
