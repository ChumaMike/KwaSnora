<%- include('../partials/header') %>
<style>
  .chat-container {
    height: calc(100vh - 200px);
    overflow-y: auto;
    border: 1px solid #dee2e6;
    border-radius: 12px;
    background: #fafafa;
    padding: 1.5rem;
  }
  .message { max-width: 80%; margin-bottom: 1rem; }
  .message.user { margin-left: auto; text-align: right; }
  .message.model { margin-right: auto; }
  .bubble {
    display: inline-block;
    padding: 0.75rem 1rem;
    border-radius: 18px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .message.user .bubble { background: #0d6efd; color: white; border-bottom-right-radius: 4px; }
  .message.model .bubble { background: white; border: 1px solid #e0e0e0; border-bottom-left-radius: 4px; }
  .chat-time { font-size: 0.7rem; color: #aaa; margin-top: 4px; }
  #typing-indicator { display: none; }
  #typing-indicator.show { display: block; }
</style>

<div class="d-flex">
  <%- include('../partials/nav') %>
  <div class="main-content flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0 fw-bold">🤖 AI Business Assistant</h4>
      <form method="POST" action="/admin/ai-chat/clear" onsubmit="return confirm('Clear all chat history?')">
        <button type="submit" class="btn btn-sm btn-outline-secondary">Clear History</button>
      </form>
    </div>

    <div class="card shadow-sm p-3">
      <div class="chat-container" id="chatContainer">
        <% if (history.length === 0) { %>
        <div class="text-center text-muted py-5">
          <div style="font-size:3rem">🤖</div>
          <p class="mt-3">Hi! I'm your AI business assistant powered by Gemini.<br>
          Ask me anything about your orders, revenue, stock levels, or business performance.</p>
          <div class="d-flex gap-2 flex-wrap justify-content-center mt-3">
            <button class="btn btn-sm btn-outline-primary suggestion-btn">How many orders today?</button>
            <button class="btn btn-sm btn-outline-primary suggestion-btn">What's my total revenue?</button>
            <button class="btn btn-sm btn-outline-primary suggestion-btn">Which items are low on stock?</button>
            <button class="btn btn-sm btn-outline-primary suggestion-btn">What are my top selling items?</button>
          </div>
        </div>
        <% } %>
        <% history.forEach(msg => { %>
        <div class="message <%= msg.role === 'user' ? 'user' : 'model' %>">
          <div class="bubble"><%= msg.content %></div>
          <div class="chat-time"><%= msg.role === 'user' ? 'You' : 'AI' %> · <%= new Date(msg.created_at).toLocaleTimeString() %></div>
        </div>
        <% }) %>

        <div id="typing-indicator" class="message model">
          <div class="bubble text-muted">
            <span class="spinner-grow spinner-grow-sm" role="status"></span>
            <span class="spinner-grow spinner-grow-sm" role="status" style="animation-delay:0.2s"></span>
            <span class="spinner-grow spinner-grow-sm" role="status" style="animation-delay:0.4s"></span>
          </div>
        </div>
      </div>

      <form id="chatForm" class="d-flex gap-2 mt-3">
        <input type="text" id="messageInput" class="form-control" placeholder="Ask anything about your business..." autocomplete="off">
        <button type="submit" class="btn btn-primary px-4">
          <i class="bi bi-send"></i>
        </button>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const chatContainer = document.getElementById('chatContainer');
const chatForm = document.getElementById('chatForm');
const messageInput = document.getElementById('messageInput');
const typingIndicator = document.getElementById('typing-indicator');

function scrollToBottom() {
  chatContainer.scrollTop = chatContainer.scrollHeight;
}
scrollToBottom();

function addMessage(role, content) {
  const now = new Date().toLocaleTimeString();
  const div = document.createElement('div');
  div.className = `message ${role}`;
  div.innerHTML = `
    <div class="bubble">${escapeHtml(content)}</div>
    <div class="chat-time">${role === 'user' ? 'You' : 'AI'} · ${now}</div>
  `;
  chatContainer.insertBefore(div, typingIndicator);
  scrollToBottom();
}

function escapeHtml(text) {
  return text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
}

chatForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const message = messageInput.value.trim();
  if (!message) return;
  messageInput.value = '';

  // Remove empty-state prompt if present
  const emptyState = chatContainer.querySelector('.text-center.text-muted');
  if (emptyState) emptyState.remove();

  addMessage('user', message);
  typingIndicator.classList.add('show');
  scrollToBottom();

  try {
    const res = await fetch('/admin/ai-chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message })
    });
    const data = await res.json();
    typingIndicator.classList.remove('show');
    if (data.reply) {
      addMessage('model', data.reply);
    } else {
      addMessage('model', data.error || 'Sorry, something went wrong.');
    }
  } catch (err) {
    typingIndicator.classList.remove('show');
    addMessage('model', 'Network error. Please try again.');
  }
});

// Suggestion buttons
document.querySelectorAll('.suggestion-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    messageInput.value = btn.textContent;
    chatForm.dispatchEvent(new Event('submit'));
  });
});

// Enter to submit
messageInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    chatForm.dispatchEvent(new Event('submit'));
  }
});
</script>
</body>
</html>
