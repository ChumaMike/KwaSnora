<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Error</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark d-flex align-items-center justify-content-center" style="min-height:100vh">
  <div class="card text-center p-5 shadow-lg" style="max-width:500px">
    <div class="mb-3" style="font-size:3rem">⚠️</div>
    <h3 class="text-danger">Something went wrong</h3>
    <p class="text-muted mt-2"><%= message || 'An unexpected error occurred.' %></p>
    <a href="/admin/dashboard" class="btn btn-primary mt-3">← Back to Dashboard</a>
  </div>
</body>
</html>
