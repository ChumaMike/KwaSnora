PORT=3000

# REQUIRED: Change this to a long random string before deploying
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Set to 'production' when deploying (enables HTTPS-only cookies, Twilio signature check)
NODE_ENV=development

# Admin access — visit /admin?pass=YOUR_PASSWORD
# REQUIRED: Change this from the default before deploying
ADMIN_PASSWORD=admin123

# Database (auto-created on first run)
DATABASE_PATH=./data/kwasnora.db

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
ADMIN_WHATSAPP=whatsapp:+27000000000

# Google Gemini (free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Business config
BUSINESS_NAME=KwaSnora
STOCK_ALERT_THRESHOLD=5
